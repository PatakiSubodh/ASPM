# LOCAL DEV ONLY: read by `uvicorn main:app` run from backend/.
# Docker mode uses the root .env instead. Never commit the real backend/.env.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aspm_dev_password

# --- API access (must match ASPM_API_KEY in scanner / discovery if you run them) ---
ASPM_API_KEY=change-me
ASPM_DEV_OWNER=
CATALOG_PATH=../catalog.yaml

# --- Supabase (same project as NEXT_PUBLIC_SUPABASE_URL in frontend/.env.local) ---
SUPABASE_URL=https://your-supabase-url.supabase.co

# --- GitHub App (secrets stay here, never in the frontend) ---
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_PRIVATE_KEY_PATH=path/to/your/private-key.pem
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_AUTH_REDIRECT_URI=http://localhost:3000/github/authorized
INSTALL_STATE_SECRET=your-install-state-secret
