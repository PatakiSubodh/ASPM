# DOCKER MODE ONLY: read by `docker compose up` from the repo root.
# Running uvicorn / npm run dev locally? Use backend/.env and frontend/.env.local instead.
# Never commit the real .env. Server secrets stay here, never in NEXT_PUBLIC_*.

# --- Ports ---
API_PORT=8000
WEB_PORT=3000

# --- Neo4j ---
NEO4J_PASSWORD=aspm_dev_password

# --- API access ---
ASPM_API_KEY=change-me
ASPM_DEV_OWNER=

# --- Supabase (public values, also baked into the web image) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- GitHub App (API only) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_AUTH_REDIRECT_URI=http://localhost:3000/github/authorized
INSTALL_STATE_SECRET=change-me

# --- Scanner / discovery (legacy single-tenant, removed in Phases 5-6) ---
GITHUB_TOKEN=
SCAN_INTERVAL_MINUTES=360
SCAN_ON_START=true
DISCOVERY_INTERVAL_MINUTES=15
